{
  "name": "@meteorlxy/create",
  "version": "4.4.0",
  "description": "Create JavaScript Project",
  "keywords": [
    "create",
    "scaffolding"
  ],
  "homepage": "https://github.com/meteorlxy/create#readme",
  "bugs": {
    "url": "https://github.com/meteorlxy/create/issues"
  },
  "license": "MIT",
  "author": "meteorlxy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meteorlxy/create.git"
  },
  "bin": {
    "create": "./bin/create.mjs"
  },
  "files": [
    "bin",
    "lib",
    "templates"
  ],
  "type": "module",
  "main": "./lib/index.mjs",
  "types": "./lib/index.d.mts",
  "imports": {
    "#templates/*": "./templates/*"
  },
  "exports": {
    ".": "./lib/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rimraf lib *.tsbuildinfo",
    "dev": "pnpm build && pnpm dev:clean && node bin/create.mjs dev",
    "dev:clean": "rimraf dev",
    "format": "oxfmt",
    "lint": "oxlint && oxfmt --check && ls-lint",
    "lint:fix": "oxlint --fix && oxfmt",
    "prepare": "husky",
    "release": "pnpm release:check && pnpm release:version",
    "release:changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "release:check": "pnpm clean && pnpm build && pnpm lint",
    "release:version": "bumpp --execute=\"pnpm release:changelog\" --commit \"build: publish v%s\" --all"
  },
  "dependencies": {
    "chalk": "^6.0.1",
    "ejs": "^7.0.2",
    "execa": "^10.2.1",
    "fs-extra": "^11.4.1",
    "lodash.merge": "^4.6.2",
    "ora": "^10.0.0",
    "prompts": "^2.4.2",
    "sort-package-json": "^4.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@ls-lint/ls-lint": "^2.3.2",
    "@meteorlxy/create": "link:",
    "@meteorlxy/oxfmt-config": "^7.10.0",
    "@meteorlxy/oxlint-config": "^7.10.0",
    "@meteorlxy/tsconfig": "^7.7.1",
    "@types/ejs": "^3.1.5",
    "@types/fs-extra": "^11.0.4",
    "@types/lodash.merge": "^4.6.9",
    "@types/node": "^26.6.6",
    "@types/prompts": "^2.4.9",
    "bumpp": "^12.3.0",
    "conventional-changelog": "^8.1.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "rimraf": "^6.1.4",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.(js|mjs|mts|ts)": [
      "oxlint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.!(js|mjs|mts|ts)": "oxfmt --no-error-on-unmatched-pattern"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0"
    },
    "runtime": {
      "name": "node",
      "version": "26.13.0"
    }
  }
}
